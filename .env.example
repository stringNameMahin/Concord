

# in .env
# GEMINI_API_KEY= <single gemini api key> -- (Single key either paid or free, remember free key is very less tokens, may stop halfway through for new document uploads)

# GEMINI_API_KEYS= <key1>,<key2>,<key3> -- for multiple key queue running (things we do to save money)

# OPENROUTER_API_KEY= <single open router key> (Cheaper key if used the right model)

# More about the above in docs.





# Forget the below AI big description follow the one above ^^^ 

# Concord — configuration template. Copy to `.env` and fill in what you need.
#
#   cp .env.example .env
#
# `.env` is gitignored and must never be committed. Nothing in this file is a
# real credential.
#
# NOTHING HERE IS REQUIRED TO EVALUATE THE PROJECT. The committed ledger
# (data/db/concord.sqlite) and the committed LLM response cache (data/cache/)
# let you browse, search, byte-verify and re-derive every fact and relation
# with no key at all. See "Offline evaluation" in README.md.


# ---------------------------------------------------------------------------
# Credentials — only needed to ingest a PDF that is not already in the cache
# ---------------------------------------------------------------------------

# Google AI Studio key. The free tier is enough: a 100-page PDF is about
# 7 extraction requests at the shipped batch size of 16.
GEMINI_API_KEY=

# Optional pool, comma-separated. Only useful for keys on SEPARATE Google
# Cloud projects — the free-tier quota is billed per project, not per key, so
# several keys inside one project share one bucket.
# GEMINI_API_KEYS=

# OpenRouter key, the per-token fallback when a Gemini daily cap is hit.
# Extraction quality is materially worse on the open models tested here; see
# the Qwen entry in docs/decisions.md before pointing extraction at one.
# OPENROUTER_API_KEY=


# ---------------------------------------------------------------------------
# Offline mode — the reviewer's path
# ---------------------------------------------------------------------------

# 1 refuses every network call and serves LLM responses from data/cache/ only.
# A request with no cached response raises MissingFromCache instead of being
# guessed at. The whole six-document corpus replays under this setting for
# zero live requests.
# CONCORD_OFFLINE=1


# ---------------------------------------------------------------------------
# Model and batching — these are CACHE KEYS, not just tuning knobs
# ---------------------------------------------------------------------------
# data/cache/ is content-addressed on the whole request payload, and the
# payload carries the model name; batch size decides how passages are grouped
# into prompts, so it changes every prompt too. Changing either makes a
# re-ingest of the shipped corpus re-buy every response at full price. The
# defaults below describe the artifacts that ship. See docs/decisions.md,
# "Defaults are cache keys".

# CONCORD_LLM_MODEL=gemini-3.1-flash-lite
# CONCORD_BATCH_SIZE=16
# CONCORD_LLM_PROVIDER=            # inferred from the model name
# CONCORD_LLM_ENDPOINT=            # provider default unless set

# Batches in flight at once. 6 against a per-token provider, 3 against a
# rate-limited Gemini key.
# CONCORD_WORKERS=6

# Hard ceiling on live requests per client. Cache hits are free and do not
# count. 0 disables it. This is the backstop against a misconfigured run
# working through the whole corpus at full price.
# CONCORD_MAX_CALLS=200


# ---------------------------------------------------------------------------
# Paths — point these somewhere scratch to keep test ingests off the
# committed ledger. One careless POST /ingest overwrites it.
# ---------------------------------------------------------------------------
# CONCORD_DB=data/db/concord.sqlite
# CONCORD_WORK=data/work
# CONCORD_CACHE=data/cache

# Local sentence-transformer used for the semantic block and the predicate
# registry. Runs on CPU, no key, ~130 MB on first download.
# CONCORD_EMBED_MODEL=BAAI/bge-small-en-v1.5
